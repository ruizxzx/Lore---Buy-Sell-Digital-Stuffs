rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role is string && data.role in ['buyer', 'creator', 'admin'] &&
             data.createdAt is number &&
             (data.keys().hasAny(['displayName']) ? (data.displayName is string && data.displayName.size() <= 100) : true) &&
             (data.keys().hasAny(['username']) ? (data.username is string && data.username.size() <= 50 && data.username.matches('^[a-zA-Z0-9_\\-]+$')) : true) &&
             (data.keys().hasAny(['bio']) ? (data.bio is string && data.bio.size() <= 1000) : true) &&
             (data.keys().hasAny(['profileImage']) ? (data.profileImage is string && data.profileImage.size() <= 1000) : true);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'price', 'currency', 'ownerId', 'status', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.currency is string && data.currency == 'INR' &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.status is string && data.status in ['draft', 'published', 'archived'] &&
             data.createdAt is number &&
             (data.keys().hasAny(['slug']) ? (data.slug is string && data.slug.size() <= 250 && data.slug.matches('^[a-zA-Z0-9_\\-]+$')) : true) &&
             (data.keys().hasAny(['description']) ? (data.description is string && data.description.size() <= 10000) : true) &&
             (data.keys().hasAny(['shortDescription']) ? (data.shortDescription is string && data.shortDescription.size() <= 500) : true) &&
             (data.keys().hasAny(['coverImage']) ? (data.coverImage is string && data.coverImage.size() <= 5000) : true) &&
             (data.keys().hasAny(['category']) ? (data.category is string && data.category.size() <= 50) : true) &&
             (data.keys().hasAny(['tags']) ? (data.tags is list && data.tags.size() <= 10) : true) &&
             (data.keys().hasAny(['fileUrl']) ? (data.fileUrl is string && data.fileUrl.size() <= 5000) : true) &&
             (data.keys().hasAny(['updatedAt']) ? (data.updatedAt is number) : true);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['buyerId', 'creatorId', 'productId', 'amount', 'status', 'createdAt']) &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.creatorId is string && data.creatorId.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.amount is number &&
             data.status is string && data.status in ['pending', 'paid', 'refunded'] &&
             data.createdAt is number &&
             (data.keys().hasAny(['stripeSessionId']) ? (data.stripeSessionId is string && data.stripeSessionId.size() <= 256) : true) &&
             (data.keys().hasAny(['currency']) ? (data.currency is string && data.currency.size() <= 10) : true) &&
             (data.keys().hasAny(['paidAt']) ? (data.paidAt is number) : true);
    }

    // Collections

    match /users/{userId} {
      allow read: if true; // Public profiles are allowed
      allow create: if isSignedIn() && 
                    isValidId(userId) && 
                    userId == request.auth.uid && 
                    true && 
                    true;
      allow update: if isSignedIn() && 
                    userId == request.auth.uid && 
                    true &&
                    incoming().uid == existing().uid &&
                    true;
    }

    match /products/{productId} {
      allow read: if true;
      
      allow create: if isSignedIn() && 
                    isValidId(productId) && 
                    true &&
                    true &&
                    true;
      allow update: if isSignedIn() && 
                    existing().ownerId == request.auth.uid &&
                    true &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().createdAt == existing().createdAt &&
                    true;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      // Buyers can see their own orders, creators can see orders for their products
      allow get: if isSignedIn() && (existing().buyerId == request.auth.uid || existing().creatorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.creatorId == request.auth.uid);
      
      // Creating an order from the client is ONLY for pending initialization. 
      // Updates (like status=paid) happen via Admin SDK (Stripe webhook).
      allow create: if isSignedIn() && 
                    isValidId(orderId) && 
                    isValidOrder(incoming()) &&
                    incoming().buyerId == request.auth.uid &&
                    incoming().status == 'pending' &&
                    true &&
                    exists(/databases/$(database)/documents/products/$(incoming().productId));
                    
      // Client cannot update an order (especially not status or amount)
      allow update: if false; 
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                    isValidId(reviewId) &&
                    incoming().buyerId == request.auth.uid &&
                    incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
                    incoming().text is string && incoming().text.size() <= 2000 &&
                    true;
      allow update, delete: if isSignedIn() && existing().buyerId == request.auth.uid;
    }
  }
}
